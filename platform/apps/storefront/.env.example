# FreelanceNearMe — storefront (Next.js) environment example
# Copy to apps/storefront/.env.local and fill in real values. Do NOT commit the real .env.local.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=gb
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key
REVALIDATE_SECRET=change-me
NEXT_PUBLIC_SITE_NAME="Freelance Near Me"
NEXT_PUBLIC_SITE_DESCRIPTION="Hire trusted local freelancers near you — fund milestones in escrow, release when the work is done."
NEXT_PUBLIC_VENDOR_URL=http://localhost:7000
