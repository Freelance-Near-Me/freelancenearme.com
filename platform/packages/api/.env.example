# FreelanceNearMe — backend (Medusa/Mercur) environment example
# Copy to packages/api/.env and fill in real values. Do NOT commit the real .env.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
COOKIE_SECRET=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/freelancenearme_platform
# Stripe (Phase 1 step 5 / milestone escrow in Phase 2e)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
MERCUR_VENDOR_URL=http://localhost:7001
STOREFRONT_REVALIDATE_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=change-me
